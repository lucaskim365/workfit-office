// Workfit 그룹웨어 — DB 스키마의 단일 진실 (D-027)
//
// ⚠️ 레드존 (00 표준 4.4). 변경은 시니어 리뷰 필수.
// ⚠️ DB에 직접 DDL을 치지 않는다. 변경은 반드시:
//      schema.prisma 수정 → pnpm run prisma:migrate -- --name <설명> → 생성된 SQL을 읽고 커밋
//
// 모델 규약 (backend/docs/conventions.md "스키마와 마이그레이션"):
//   - 모델은 PascalCase 단수, 테이블·컬럼은 @@map/@map 으로 snake_case
//   - 이관 대상 모델에는 legacySource + legacyId 를 두고 @@unique([legacySource, legacyId]) (D-031)
//     → 나중에 붙이면 이관 파이프라인이 중복 적재를 막을 수 없다
//
// 접속 URL은 여기 없다 — Prisma 7부터 datasource.url 이 schema 에서 빠지고
// prisma.config.ts 로 옮겨졌다 (런타임 연결은 PrismaService 의 어댑터가 담당).
//
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 계정 — 인증 영역만 (D-087). 사람(인사)은 Employee 가 소유하고, 계정은 그 사람에게 발급된다.
/// 계정 없는 조직원이 정상 상태다 — 현장 작업자처럼 시스템 미사용 인원도 인사 데이터는 관리된다.
model User {
  id           BigInt  @id @default(autoincrement())
  /// 1:1 — 다계정 확장 시 이 UNIQUE 만 완화한다 (D-087)
  employeeId   BigInt  @unique @map("employee_id")
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  loginId      String  @unique @map("login_id") @db.VarChar(50)
  /// bcrypt 해시만 저장 (평문 금지)
  passwordHash String  @map("password_hash")
  /// ACTIVE / DISABLED — 계정 상태 (잠금은 lockedUntil 로 표현)
  status       String  @default("ACTIVE") @db.VarChar(20)
  /// REQ-AUTH-LOGIN-003 — 연속 실패 카운트
  failCount    Int     @default(0) @map("fail_count")
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz()
  /// 비밀번호 초기화 후 강제 변경 (REQ-USER-003)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz()
  /// 역할그룹 단일 배치 (REQ-ROLE-004, D-089). null = 최소 권한(로그인·본인 정보만)
  roleGroupId  BigInt?    @map("role_group_id")
  roleGroup    RoleGroup? @relation(fields: [roleGroupId], references: [id], onDelete: Restrict)
  /// 매트릭스 무관 전체 접근 (REQ-ROLE-006, D-089). 마지막 관리자 해제는 서비스가 막는다
  isSystemAdmin Boolean  @default(false) @map("is_system_admin")
  legacySource String?   @map("legacy_source") @db.VarChar(20)
  legacyId     String?   @map("legacy_id") @db.VarChar(64)
  createdBy    BigInt?   @map("created_by")
  updatedBy    BigInt?   @map("updated_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  refreshTokens RefreshToken[]

  @@unique([legacySource, legacyId])
  @@map("users")
}

/// 조직원 — 인사 영역 소유 (D-087). 조직 좌표(부서·직급·직책·상급자)는 계정이 아니라 사람에 붙는다.
model Employee {
  id    BigInt  @id @default(autoincrement())
  /// 사번 — PK 가 아니라 UNIQUE 제약으로만 (정석). 이관 전 데이터가 있어 nullable
  empNo String? @unique @map("emp_no") @db.VarChar(20)
  name  String  @db.VarChar(100)
  email String? @unique @db.VarChar(100)
  phone String? @db.VarChar(30)
  photoUrl String? @map("photo_url") @db.VarChar(300)
  hireDate DateTime? @map("hire_date") @db.Date
  /// 퇴사는 삭제가 아니다 (REQ-USER-005) — 과거 문서가 이 행을 참조한다. 재직 여부는 이 값으로 파생
  resignedAt DateTime? @map("resigned_at") @db.Timestamptz()

  /// 조직 배치 (org-structure 소유, REQ-ORG-009)
  departmentId BigInt? @map("department_id")
  positionId   BigInt? @map("position_id")
  jobTitleId   BigInt? @map("job_title_id")
  /// 명시 상급자 — 체인은 이것만 따른다 (REQ-ORG-010 보류, D-086)
  managerId    BigInt? @map("manager_id")

  /// 서명·도장 (L1 — 컬럼 선반영)
  signUrl  String? @map("sign_url") @db.VarChar(300)
  sealUrl  String? @map("seal_url") @db.VarChar(300)
  signType String? @map("sign_type") @db.VarChar(20)

  legacySource String? @map("legacy_source") @db.VarChar(20)
  legacyId     String? @map("legacy_id") @db.VarChar(64)
  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User?

  department   Department? @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  position     Position?   @relation(fields: [positionId], references: [id], onDelete: Restrict)
  jobTitle     JobTitle?   @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  manager      Employee?   @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  subordinates Employee[]  @relation("EmployeeManager")

  @@unique([legacySource, legacyId])
  @@index([departmentId])
  @@map("employees")
}

/// 리프레시 토큰 — auth-login 전용. SHA-256 해시만 저장(평문 금지).
model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  userId    BigInt    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  /// 로그아웃 시 기록 (REQ-AUTH-LOGIN-005)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// common-code — 코드 체계 (design 2.5절)
// ─────────────────────────────────────────────────────────────────────────────

/// 코드 그룹. `DEPT_TYPE` 처럼 코드값의 묶음 하나를 뜻한다.
model CodeGroup {
  code        String  @id @db.VarChar(30)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(300)

  /// true = 로직이 이 코드값으로 분기한다. **삭제·코드값 변경 불가, 이름 변경은 허용** (REQ-CODE-007).
  /// 값 목록은 고정인데 라벨은 회사마다 다르다 — 코드값은 로직에, 라벨은 데이터에 둔다.
  isSystem Boolean @default(false) @map("is_system")

  /// 같은 그룹 안에서 계층(대분류→중분류)을 쓰는가. 관리 화면이 트리로 보일지 목록으로 보일지 정한다.
  useHierarchy Boolean @default(false) @map("use_hierarchy")

  /// 확장 속성의 **이름**. null 이면 그 속성은 쓰지 않는다 (REQ-CODE-010).
  /// 이름 없는 확장 컬럼은 6개월 뒤 아무도 attr3 이 무엇이었는지 모른다.
  attr1Label String? @map("attr1_label") @db.VarChar(50)
  attr2Label String? @map("attr2_label") @db.VarChar(50)
  attr3Label String? @map("attr3_label") @db.VarChar(50)
  attr4Label String? @map("attr4_label") @db.VarChar(50)
  attr5Label String? @map("attr5_label") @db.VarChar(50)

  sortOrder Int     @default(0) @map("sort_order")
  /// D-050 — 물리 삭제 대신 끈다. 끈 그룹은 새로 쓰지 않지만 과거 데이터의 라벨은 살아 있다.
  useYn     Boolean @default(true) @map("use_yn")

  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  codes Code[]

  @@map("code_groups")
}

/// 코드 하나. 그룹 안에서 유일하다 (REQ-CODE-001).
model Code {
  groupCode String @map("group_code") @db.VarChar(30)
  code      String @db.VarChar(30)
  name      String @db.VarChar(100)

  /// **같은 그룹 안의** 상위 코드 — 연쇄 선택용 (REQ-CODE-008).
  /// 다른 그룹과의 연계는 CodeMapping 이 담당한다. 둘을 섞지 않는다(design 3.2).
  parentCode String? @map("parent_code") @db.VarChar(30)

  sortOrder Int     @default(0) @map("sort_order")
  /// 끄면 신규 선택지에서 빠지지만 **기존 데이터의 라벨은 그대로 보인다** (REQ-CODE-003).
  useYn     Boolean @default(true) @map("use_yn")

  /// 그룹의 attrN_label 이 정의된 것만 쓴다.
  attr1 String? @db.VarChar(100)
  attr2 String? @db.VarChar(100)
  attr3 String? @db.VarChar(100)
  attr4 String? @db.VarChar(100)
  attr5 String? @db.VarChar(100)

  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  group    CodeGroup @relation(fields: [groupCode], references: [code], onDelete: Restrict)
  /// 자기참조. 같은 그룹 안에서만 맺어지도록 groupCode 를 함께 건다.
  parent   Code?     @relation("CodeHierarchy", fields: [groupCode, parentCode], references: [groupCode, code], onDelete: Restrict)
  children Code[]    @relation("CodeHierarchy")

  mappingsAsSource CodeMapping[] @relation("MappingSource")
  mappingsAsTarget CodeMapping[] @relation("MappingTarget")

  @@id([groupCode, code])
  @@index([groupCode, sortOrder])
  @@index([groupCode, parentCode])
  @@map("codes")
}

/// 서로 다른 그룹의 **코드끼리** 맺는 연계 (REQ-CODE-009).
///
/// ⚠️ **마스터 엔티티(자기 테이블이 있는 것 — 사용자·부서·설비)를 여기 넣지 않는다.**
/// 넣으면 진실이 두 곳이 되고, source_code 가 어느 테이블을 가리키는지 DB 가 알 수 없어
/// 무결성을 못 지킨다(polymorphic FK). 그건 도메인 테이블의 FK 로 맺는다.
///
/// relation_type 이 PK 에 들어가는 이유: 같은 두 코드가 **다른 관계 종류로 동시에** 존재할 수 있다.
model CodeMapping {
  sourceGroup  String @map("source_group") @db.VarChar(30)
  sourceCode   String @map("source_code") @db.VarChar(30)
  targetGroup  String @map("target_group") @db.VarChar(30)
  targetCode   String @map("target_code") @db.VarChar(30)
  relationType String @map("relation_type") @db.VarChar(30)

  sortOrder Int @default(0) @map("sort_order")

  createdBy BigInt?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  source Code @relation("MappingSource", fields: [sourceGroup, sourceCode], references: [groupCode, code], onDelete: Restrict)
  target Code @relation("MappingTarget", fields: [targetGroup, targetCode], references: [groupCode, code], onDelete: Restrict)

  @@id([sourceGroup, sourceCode, targetGroup, targetCode, relationType])
  @@index([sourceGroup, sourceCode, relationType])
  @@map("code_mappings")
}

// ─────────────────────────────────────────────────────────────────────────────
// org-structure — 조직 (design 2.5절). L0 도메인 중립 (D-041) —
// 결재·대결 같은 그룹웨어 고유 개념을 여기 넣지 않는다.
// ─────────────────────────────────────────────────────────────────────────────

/// 부서 — 조직 트리 (REQ-ORG-001). 모든 상위 기능(결재선·근태·공개범위)이 이 트리를 소비한다.
/// **부서장 컬럼은 없다 (D-084)** — 소속 × isDeptHead 직급 × 최상위 서열로 유도한다(REQ-ORG-014).
/// 컬럼으로 두면 인사 변경이 이중 관리가 되고 퇴사자가 부서장으로 잔존한다.
model Department {
  id   BigInt @id @default(autoincrement())
  /// 외부 연계·이관 키. 지금은 수기 입력 (design 7절 미결)
  code String @unique @db.VarChar(30)
  name String @db.VarChar(100)

  /// null = 최상위. 순환은 쓰기 시점에 서비스가 막는다 (REQ-ORG-002, design 3.1)
  parentId BigInt?      @map("parent_id")
  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Department[] @relation("DeptTree")

  /// **공통코드 `DEPT_TYPE`** 의 코드값 — enum 이 아니다 (D-041: MES 는 공장/라인이 필요하다).
  /// 모듈 간 연결은 ID 값으로 한다(D-016) — FK 대신 쓰기 시점에 CodeService 로 검증한다.
  typeCode String? @map("type_code") @db.VarChar(30)

  /// 같은 상위 아래 표시 순서 (REQ-ORG-005)
  sortOrder Int     @default(0) @map("sort_order")
  /// 물리 삭제 금지(D-050) — 참조가 있으면 삭제 대신 이걸 끈다
  useYn     Boolean @default(true) @map("use_yn")

  legacySource String? @map("legacy_source") @db.VarChar(20)
  legacyId     String? @map("legacy_id") @db.VarChar(64)

  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  employees Employee[] @relation("EmployeeDepartment")

  @@unique([legacySource, legacyId])
  @@index([parentId])
  @@map("departments")
}

/// 직급 — 서열의 유일한 근거 (REQ-ORG-006).
/// 프로토타입의 RANK_FALLBACK 상수를 승계하지 않는다 — 조직 개편이 배포가 되면 안 된다.
model Position {
  id   BigInt @id @default(autoincrement())
  name String @unique @db.VarChar(50)
  /// **작을수록 상위.** 서열 비교는 이 값만 본다
  rank Int
  sortOrder  Int     @default(0) @map("sort_order")
  useYn      Boolean @default(true) @map("use_yn")

  legacySource String? @map("legacy_source") @db.VarChar(20)
  legacyId     String? @map("legacy_id") @db.VarChar(64)

  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  employees Employee[]

  @@unique([legacySource, legacyId])
  @@map("positions")
}

/// 직책 — 직급과 **별개 축** (REQ-ORG-008). 같은 과장이라도 팀장일 수도 아닐 수도 있다.
/// L2 라 CRUD API 는 아직 없지만 스키마는 함께 세운다 — 나중에 붙이면 마이그레이션이 두 번 된다.
model JobTitle {
  id        BigInt  @id @default(autoincrement())
  name      String  @unique @db.VarChar(50)
  sortOrder Int     @default(0) @map("sort_order")
  useYn     Boolean @default(true) @map("use_yn")

  legacySource String? @map("legacy_source") @db.VarChar(20)
  legacyId     String? @map("legacy_id") @db.VarChar(64)

  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  employees Employee[]

  @@unique([legacySource, legacyId])
  @@map("job_titles")
}

/// 메뉴 트리 (role-mgmt REQ-ROLE-007). PK 가 의미 있는 키(`S_SYS_USER`)인 이유:
/// @RequirePermission 데코레이터에 이 값이 박히므로 사람이 읽을 수 있어야 한다 (design 7절).
model Menu {
  id       String  @id @db.VarChar(40)
  /// null = 최상위. 순환은 쓰기 시점에 서비스가 막는다 (부서 트리와 같은 방식)
  parentId String? @map("parent_id") @db.VarChar(40)
  parent   Menu?   @relation("MenuTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Menu[]  @relation("MenuTree")
  name     String  @db.VarChar(100)
  /// 화면 노드만 값이 있다 — 프론트 화면 등록표(registry)의 경로
  url      String? @db.VarChar(200)
  icon     String? @db.VarChar(40)
  sortOrder Int    @default(0) @map("sort_order")
  /// **기본값이 false 다** — 미구현 화면이 켜진 채 나가지 않게 (REQ-ROLE-007)
  useYn     Boolean @default(false) @map("use_yn")

  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  permissions RolePermission[]

  @@map("menus")
}

/// 역할그룹 (REQ-ROLE-001) — 프로토타입 authRole/roleGroup 공존을 roleGroup 하나로 통일 (design 1절)
model RoleGroup {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique @db.VarChar(30)
  name        String  @db.VarChar(100)
  description String? @db.VarChar(200)
  useYn       Boolean @default(true) @map("use_yn")

  createdBy BigInt?  @map("created_by")
  updatedBy BigInt?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  permissions RolePermission[]
  users       User[]

  @@map("role_groups")
}

/// 시스템 활용도 집계 (system-log 5절, 미결 M — 스마트공장 KPI). **원시 로그가 아니라 카운터다**:
/// 전 요청 원시 적재는 로그 폭증이라, 인터셉터가 메모리에 모아 주기적으로 여기 증분한다.
/// 정부 보고 양식이 오면 이 축(사용자×기능×일)에서 집계해 내보낸다 — 컬럼 확장은 그때.
model UsageDaily {
  day    DateTime @db.Date
  /// 0 = 비로그인(공개 엔드포인트) — 복합 PK 라 null 대신 0 을 쓴다
  userId BigInt   @map("user_id")
  method String   @db.VarChar(8)
  /// 라우트 패턴(`/api/employees/:id`) — 실제 id 가 들어가면 행이 폭증한다
  path   String   @db.VarChar(150)

  calls    Int    @default(0)
  /// 4xx·5xx 응답 — 활용이 아니라 마찰의 신호라 따로 센다
  errors   Int    @default(0)
  reqBytes BigInt @default(0) @map("req_bytes")
  resBytes BigInt @default(0) @map("res_bytes")

  @@id([day, userId, method, path])
  @@map("usage_daily")
}

/// 권한 매트릭스 — 한 칸이 한 행. **boolean[][] 로 저장하지 않는다**: 배열이면 메뉴 추가 시
/// 위치가 밀려 기존 권한이 통째로 어긋난다 (design 2.5). 행이 없으면 = 권한 없음.
model RolePermission {
  roleGroupId BigInt    @map("role_group_id")
  roleGroup   RoleGroup @relation(fields: [roleGroupId], references: [id], onDelete: Cascade)
  menuId      String    @map("menu_id") @db.VarChar(40)
  menu        Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  /// 조회 = 메뉴 노출 + 데이터 읽기 + 엑셀 (D-089)
  canRead     Boolean   @default(false) @map("can_read")
  /// 편집 = 신규 + 수정 + 삭제 (D-089)
  canWrite    Boolean   @default(false) @map("can_write")

  @@id([roleGroupId, menuId])
  @@map("role_permissions")
}
