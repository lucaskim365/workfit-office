<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows 10에 기본 탑재된 .NET Framework 4.8 → 대상 PC에 런타임 설치 불필요 -->
    <TargetFramework>net48</TargetFramework>
    <!-- 64비트 ACE(Microsoft.ACE.OLEDB.16.0)를 쓰므로 x64 고정.
         만약 Jet.OLEDB.4.0(32비트)로 폴백해야 하면 x86으로 바꾸고 config의 OleDbProvider도 교체 -->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>CapsSync</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- OLEDB(Access), JSON, HTTP 용 프레임워크 어셈블리 -->
    <Reference Include="System.Data" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- 설정 파일들을 출력 폴더로 복사 (config.json 은 실제 설정, example 은 템플릿) -->
    <None Update="config.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- config.json 은 저장소에 없다(비밀번호가 들어가서 gitignore 대상).
         각자 config.example.json 을 복사해 만들며, 있을 때만 출력 폴더로 복사한다. -->
    <None Update="config.json" Condition="Exists('config.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
