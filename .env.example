# Firebase 웹 클라이언트 설정 (VITE_ 접두사 = 클라이언트 노출용)
# Vercel 환경변수(Production/Preview/Development)에 동일 키로 등록하고,
# 로컬은 .env.local 에 값을 채워 사용하세요. (.env.local 은 git 제외)
VITE_FB_API_KEY="your-api-key"
VITE_FB_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FB_PROJECT_ID="your-project-id"
VITE_FB_APP_ID="your-app-id"
VITE_FB_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FB_MESSAGING_SENDER_ID="your-sender-id"
# (선택) 명명된 Firestore 데이터베이스 ID. 기본 DB면 비워두세요.
VITE_FB_FIRESTORE_DB_ID=""

# 로그인 게이트. "true" 일 때만 로그인 화면이 뜬다.
# 콘솔 Auth(이메일/비번 공급자 + 계정) 준비가 끝나면 "true"로 켜세요.
VITE_AUTH_ENABLED="false"

# (PWA 웹 푸시) Firebase 콘솔 > 프로젝트 설정 > Cloud Messaging > 웹 푸시 인증서 > 키 쌍
# 에서 발급한 공개 VAPID 키(B...로 시작). 없으면 푸시만 비활성(설치·메신저는 동작).
VITE_FB_VAPID_KEY=""

# ── 파일 스토리지 드라이버 (src/shared/lib/storage.ts) ──
# 파일 업로드(프로필·인감·채팅첨부·로고·결재첨부) 저장 백엔드 선택.
#   "firebase" : Firebase Storage (기본, 위 VITE_FB_* 설정 사용)
#   "s3"       : Garage 등 S3 호환 자체 파일서버 (VITE_STORAGE_SIGN_URL 필요)
#   "dataurl"  : 저장 없이 base64 미리보기 (데모/오프라인)
# 미지정 시: Firebase 설정돼 있으면 firebase, 아니면 dataurl 로 자동 폴백.
VITE_STORAGE_DRIVER=""
# s3 드라이버용 presigned URL 발급 API 엔드포인트 (DMZ 서명 서버). 예: https://file.widdyax.com/api/sign
VITE_STORAGE_SIGN_URL=""
# (임시) 서명 API Bearer 토큰. 서명 API가 SIGN_API_TOKEN 게이트일 때 사용.
#   ⚠️ 번들에 노출되므로 임시 조치. 앱 Firebase Auth 도입 시 ID토큰 검증으로 교체 예정.
VITE_STORAGE_SIGN_TOKEN=""

# ── DB 드라이버 (Firestore→Appwrite 이관 PoC · src/shared/lib/dbDriver.ts) ──
# repo가 읽는 저장소 백엔드 스위치. PoC 대상 repo(chatMessage·notification)에만 적용.
#   "firestore" : 현행 Firestore (기본)
#   "appwrite"  : 자체호스팅 Appwrite (아래 3개 값 필요)
# 미지정 시: Firebase 설정돼 있으면 firestore, 아니면 memory 폴백.
VITE_DB_DRIVER=""
# Appwrite API 엔드포인트(/v1 포함). 예: https://appwrite.widdyax.com/v1
VITE_APPWRITE_ENDPOINT=""
# Appwrite 프로젝트 ID. 예: 6a6bf85e002acb7f71d6 (workfit-intra)
VITE_APPWRITE_PROJECT_ID=""
# Console에서 생성한 Database ID. 예: workfit
VITE_APPWRITE_DATABASE_ID=""
# ── (IaC 전용) 스키마 생성 스크립트 npm run appwrite:schema 에서만 사용 ──
# 서버 API 키(비밀). Console > 프로젝트 > API Keys 에서 databases 스코프로 발급.
#   ⚠️ VITE_ 아님 — 브라우저 번들에 절대 넣지 말 것. .env.local 에만 두고 Git 커밋 금지.
APPWRITE_API_KEY=""

# ── Widdy(위디) RAG 챗봇 게이트웨이 (src/data/widdyChat/widdyChat.repo.ts) ──
#   둘 다 비우면 데모 스텁으로 동작(graceful degrade).
#   옵션 B: DMZ HTTP(S) 게이트웨이 (인증 게이트 포함). 예: https://appwrite.widdyax.com/widdy/chat
VITE_WIDDY_CHAT_URL=""
# (임시) 위 게이트웨이 Bearer 토큰. 실인증 도입 전 스톱갭.
VITE_WIDDY_CHAT_TOKEN=""
#   옵션 A: Appwrite Function ID (세션 인증). 예: widdy-chat
VITE_WIDDY_FUNCTION_ID=""
